<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<title>GameHub — Premium Games</title>
<meta name="theme-color" content="#0a0e14">
<style>
*{box-sizing:border-box;margin:0;padding:0;-webkit-tap-highlight-color:transparent}
:root{
  --bg:#0a0e14;--surface:rgba(255,255,255,.05);--surface2:rgba(255,255,255,.08);
  --stroke:rgba(255,255,255,.09);--stroke2:rgba(255,255,255,.18);
  --txt:#eef2f8;--txt2:#8b96ab;--blue:#4f8eff;--purple:#a78bfa;--pink:#f472b6;
  --green:#10b981;--red:#f43f5e;--amber:#fbbf24;--star:#fbbc04;
}
html,body{height:100%}
body{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,system-ui,sans-serif;background:var(--bg);color:var(--txt);min-height:100vh;overflow-x:hidden;-webkit-font-smoothing:antialiased;padding-bottom:env(safe-area-inset-bottom)}
body::before{content:'';position:fixed;inset:0;z-index:-2;pointer-events:none;background:radial-gradient(60% 40% at 15% 0%, rgba(79,142,255,.18), transparent 60%),radial-gradient(50% 40% at 85% 10%, rgba(167,139,250,.15), transparent 60%),radial-gradient(60% 50% at 50% 100%, rgba(16,185,129,.1), transparent 60%)}
body::after{content:'';position:fixed;inset:0;z-index:-1;pointer-events:none;background-image:radial-gradient(rgba(255,255,255,.025) 1px,transparent 1px);background-size:32px 32px;mask-image:radial-gradient(circle at 50% 30%, #000 20%, transparent 80%)}
::-webkit-scrollbar{width:10px;height:10px}
::-webkit-scrollbar-thumb{background:rgba(255,255,255,.1);border-radius:5px}
button{font-family:inherit;cursor:pointer}
input{font-family:inherit}

@keyframes fadeUp{from{opacity:0;transform:translateY(16px)}to{opacity:1;transform:none}}
@keyframes fadeIn{from{opacity:0}to{opacity:1}}
@keyframes popIn{from{transform:scale(0) rotate(-30deg);opacity:0}60%{transform:scale(1.2) rotate(10deg)}100%{transform:scale(1) rotate(0);opacity:1}}
@keyframes bounceIn{0%{transform:scale(0) rotate(-30deg)}55%{transform:scale(1.3) rotate(15deg)}75%{transform:scale(.95) rotate(-5deg)}100%{transform:scale(1) rotate(0)}}
@keyframes pulse{0%,100%{opacity:1}50%{opacity:.35}}
@keyframes confFall{0%{transform:translateY(0) rotate(0);opacity:1}100%{transform:translateY(110vh) rotate(720deg);opacity:0}}
@keyframes shake{0%,100%{transform:translateX(0)}20%{transform:translateX(-14px) rotate(-2deg)}40%{transform:translateX(14px) rotate(2deg)}60%{transform:translateX(-9px) rotate(-1deg)}80%{transform:translateX(9px) rotate(1deg)}}
@keyframes loseDrop{0%{transform:translateY(-60px) scale(.5);opacity:0}60%{transform:translateY(10px) scale(1.05)}100%{transform:translateY(0) scale(1);opacity:1}}
@keyframes turnBannerIn{0%{transform:translate(-50%,-120%) scale(.7);opacity:0}60%{transform:translate(-50%,8px) scale(1.05);opacity:1}100%{transform:translate(-50%,0) scale(1)}}
@keyframes glowPulse{0%,100%{box-shadow:0 0 0 0 rgba(34,197,94,.6),0 0 20px 4px rgba(34,197,94,.4)}50%{box-shadow:0 0 0 20px rgba(34,197,94,0),0 0 40px 10px rgba(34,197,94,.7)}}
@keyframes thinkB{0%,60%,100%{transform:translateY(0);opacity:.4}30%{transform:translateY(-5px);opacity:1}}

#splash{position:fixed;inset:0;z-index:10000;background:radial-gradient(circle at 50% 40%, #14203a 0%, #0a0e14 70%);display:grid;place-items:center;transition:opacity .6s, visibility .6s}
#splash.off{opacity:0;visibility:hidden;pointer-events:none}
.sp-logo{width:96px;height:96px;border-radius:28px;margin:0 auto 26px;background:linear-gradient(135deg,#4f8eff,#a78bfa 60%,#f472b6);display:grid;place-items:center;font-size:48px;color:#fff;box-shadow:0 30px 70px -12px rgba(79,142,255,.7),inset 0 2px 0 rgba(255,255,255,.25);animation:spB 1.5s cubic-bezier(.4,0,.2,1) infinite}
@keyframes spB{0%,100%{transform:translateY(0) rotate(-2deg) scale(1)}50%{transform:translateY(-10px) rotate(2deg) scale(1.05)}}
.sp-name{font-size:36px;font-weight:900;letter-spacing:-1.5px;background:linear-gradient(92deg,#4f8eff,#a78bfa 50%,#f472b6);-webkit-background-clip:text;background-clip:text;color:transparent;background-size:200% auto;animation:gr 3s linear infinite;text-align:center}
@keyframes gr{to{background-position:200% center}}
.sp-sub{margin-top:26px;font-size:10.5px;color:var(--txt2);letter-spacing:2.6px;text-transform:uppercase;font-weight:800;text-align:center}
.sp-bar{width:200px;height:3px;background:rgba(255,255,255,.08);border-radius:2px;margin:28px auto 0;overflow:hidden}
.sp-bar i{display:block;height:100%;width:0%;background:linear-gradient(90deg,#4f8eff,#a78bfa,#f472b6);border-radius:2px;box-shadow:0 0 12px rgba(79,142,255,.8);transition:width .35s}

.topnav{position:sticky;top:0;z-index:100;background:rgba(10,14,20,.72);backdrop-filter:blur(24px);border-bottom:1px solid var(--stroke);padding-top:env(safe-area-inset-top)}
.topnav-in{max-width:1280px;margin:0 auto;padding:14px 22px;display:flex;align-items:center;gap:16px}
.logo{display:flex;align-items:center;gap:11px;font-weight:900;font-size:20px;letter-spacing:-.6px;cursor:pointer;flex-shrink:0}
.logo .pi{width:36px;height:36px;border-radius:11px;background:linear-gradient(135deg,#4f8eff,#a78bfa 60%,#f472b6);display:grid;place-items:center;font-size:17px;color:#fff;box-shadow:0 8px 22px -6px rgba(79,142,255,.7)}
.logo .tx{background:linear-gradient(92deg,#fff,#a5d8ff 60%,#c4b5fd);-webkit-background-clip:text;background-clip:text;color:transparent}
.searchbar{flex:1;min-width:0;max-width:560px;margin:0 auto;display:flex;align-items:center;gap:11px;background:var(--surface);border:1px solid var(--stroke);border-radius:14px;padding:10px 18px;transition:all .25s}
.searchbar:focus-within{border-color:rgba(79,142,255,.55);background:var(--surface2);box-shadow:0 0 0 4px rgba(79,142,255,.12)}
.searchbar svg{width:17px;height:17px;fill:var(--txt2)}
.searchbar input{flex:1;min-width:0;background:none;border:none;outline:none;color:var(--txt);font-size:14.5px;font-weight:500}
.searchbar input::placeholder{color:var(--txt2)}
.nav-stat{display:flex;align-items:center;gap:6px;font-size:12px;font-weight:800;color:var(--txt2);padding:8px 14px;border-radius:999px;background:var(--surface);border:1px solid var(--stroke)}
.nav-stat .dt{width:6px;height:6px;border-radius:50%;background:#22c55e;box-shadow:0 0 10px #22c55e;animation:pulse 2s infinite}

.container{max-width:1280px;margin:0 auto;padding:0 22px 40px}
.section-head{display:flex;align-items:center;justify-content:space-between;margin:36px 0 20px}
.section-head h2{font-size:22px;font-weight:900;letter-spacing:-.7px;display:flex;align-items:center;gap:10px}
.section-head h2 .dot{width:8px;height:8px;border-radius:50%;background:linear-gradient(135deg,#4f8eff,#a78bfa);box-shadow:0 0 14px #4f8eff}
.section-head .count{font-size:12.5px;font-weight:800;color:var(--txt2);padding:6px 12px;border-radius:999px;background:var(--surface);border:1px solid var(--stroke)}

.hero{margin-top:26px;border-radius:26px;overflow:hidden;position:relative;min-height:280px;cursor:pointer;display:flex;align-items:flex-end;transition:transform .4s;box-shadow:0 30px 70px -30px rgba(0,0,0,.9);border:1px solid var(--stroke)}
.hero:hover{transform:translateY(-3px)}
.hero::before{content:'';position:absolute;inset:0;background:linear-gradient(160deg,transparent 20%, rgba(0,0,0,.55) 60%, rgba(0,0,0,.92));z-index:1}
.hero-badge{position:absolute;top:22px;left:22px;z-index:3;font-size:10.5px;font-weight:900;letter-spacing:1.4px;text-transform:uppercase;background:rgba(255,255,255,.18);backdrop-filter:blur(14px);padding:7px 14px;border-radius:999px;color:#fff;border:1px solid rgba(255,255,255,.25);display:flex;align-items:center;gap:6px}
.hero-badge::before{content:'';width:6px;height:6px;border-radius:50%;background:#22c55e;box-shadow:0 0 10px #22c55e;animation:pulse 1.5s infinite}
.hero-in{position:relative;z-index:2;padding:30px;width:100%;display:flex;align-items:flex-end;gap:22px}
.hero-icon{width:96px;height:96px;border-radius:24px;flex-shrink:0;display:grid;place-items:center;font-size:48px;box-shadow:0 20px 50px -10px rgba(0,0,0,.7),inset 0 2px 0 rgba(255,255,255,.2)}
.hero-text{flex:1;min-width:0}
.hero-text h3{font-size:30px;font-weight:900;letter-spacing:-1px;margin-bottom:8px;line-height:1.1}
.hero-meta{display:flex;gap:14px;flex-wrap:wrap;align-items:center;font-size:13.5px;color:rgba(255,255,255,.82);font-weight:600}
.hero-meta .st{display:inline-flex;align-items:center;gap:4px;color:var(--star)}
.hero-play{margin-top:16px;display:inline-flex;align-items:center;gap:8px;background:#fff;color:#0a0e14;font-weight:900;font-size:14px;padding:11px 22px;border-radius:12px;transition:transform .2s}
.hero:hover .hero-play{transform:scale(1.04)}

.chips{display:flex;gap:10px;overflow-x:auto;padding:6px 0 20px;scrollbar-width:none}
.chips::-webkit-scrollbar{display:none}
.chip{flex-shrink:0;font-size:13.5px;font-weight:800;background:var(--surface);color:var(--txt2);border:1px solid var(--stroke);border-radius:999px;padding:10px 20px;transition:all .22s;white-space:nowrap}
.chip:hover{background:var(--surface2);color:var(--txt)}
.chip.on{background:linear-gradient(135deg,#4f8eff,#2563eb);color:#fff;border-color:transparent;box-shadow:0 10px 24px -8px rgba(79,142,255,.7)}

.game-grid{display:grid;gap:16px;grid-template-columns:repeat(auto-fill,minmax(180px,1fr))}
@media(max-width:640px){.game-grid{grid-template-columns:repeat(2,1fr);gap:14px}}
.game-card{position:relative;overflow:hidden;background:linear-gradient(158deg, rgba(255,255,255,.06), rgba(255,255,255,.018));border:1px solid var(--stroke);border-radius:22px;padding:22px 16px 18px;cursor:pointer;transition:all .4s;display:flex;flex-direction:column;align-items:center;text-align:center;animation:cardIn .55s cubic-bezier(.2,.9,.3,1) forwards;opacity:0}
@keyframes cardIn{from{opacity:0;transform:translateY(24px) scale(.96)}to{opacity:1;transform:none}}
.game-card::after{content:'';position:absolute;inset:-1px;border-radius:inherit;padding:1px;background:linear-gradient(140deg,var(--glow,transparent), transparent 40%, transparent 60%, var(--glow2,transparent));-webkit-mask:linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);-webkit-mask-composite:xor;mask-composite:exclude;opacity:0;transition:opacity .4s;pointer-events:none}
.game-card:hover::after{opacity:1}
.game-card:hover{transform:translateY(-6px);border-color:transparent;box-shadow:0 26px 50px -22px var(--glow,rgba(79,142,255,.5))}
.game-card .ic{width:88px;height:88px;border-radius:22px;flex-shrink:0;display:grid;place-items:center;font-size:42px;box-shadow:0 14px 32px -10px rgba(0,0,0,.75),inset 0 2px 0 rgba(255,255,255,.22);transition:transform .5s;margin-bottom:16px}
.game-card:hover .ic{transform:translateY(-5px) rotate(-5deg) scale(1.08)}
.game-card .tag{display:inline-block;font-size:10px;font-weight:900;letter-spacing:.9px;text-transform:uppercase;padding:4px 11px;border-radius:8px;background:rgba(79,142,255,.18);color:#8ec2ff;margin-bottom:10px;border:1px solid rgba(79,142,255,.25)}
.game-card h4{font-size:17px;font-weight:900;letter-spacing:-.5px;margin-bottom:8px;line-height:1.25;color:#fff;text-shadow:0 1px 4px rgba(0,0,0,.6);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;width:100%;padding:0 4px}
.game-card .meta{font-size:12.5px;color:var(--txt2);font-weight:700;display:flex;gap:6px;align-items:center;justify-content:center;flex-wrap:wrap;margin-bottom:6px}
.game-card .meta .s{color:var(--star)}
.game-card .cta{margin-top:auto;display:flex;align-items:center;justify-content:center;padding-top:12px;width:100%;border-top:1px solid rgba(255,255,255,.06)}
.game-card .cta .btn-txt{font-size:12px;font-weight:900;letter-spacing:.7px;text-transform:uppercase;color:#8ec2ff;transition:color .3s}
.game-card:hover .cta .btn-txt{color:#4f8eff}
@media(max-width:640px){
  .game-card{padding:18px 12px 16px}
  .game-card .ic{width:72px;height:72px;font-size:34px;border-radius:18px;margin-bottom:14px}
  .game-card h4{font-size:14.5px}
  .game-card .tag{font-size:9.5px}
}

.detail{animation:fadeUp .45s}
.back{display:inline-flex;align-items:center;gap:8px;padding:20px 0 14px;font-size:14px;font-weight:800;color:var(--txt2);background:none;border:none}
.back:hover{color:var(--blue)}
.detail-hero{position:relative;border-radius:26px;overflow:hidden;padding:38px 32px;margin-bottom:28px;border:1px solid var(--stroke);box-shadow:0 26px 60px -30px rgba(0,0,0,.7)}
.detail-hero::before{content:'';position:absolute;inset:0;background:linear-gradient(160deg,transparent 30%, rgba(0,0,0,.5))}
.detail-hero-in{position:relative;z-index:2;display:flex;gap:26px;align-items:flex-start;flex-wrap:wrap}
.detail-icon{width:132px;height:132px;border-radius:32px;flex-shrink:0;display:grid;place-items:center;font-size:64px;box-shadow:0 24px 60px -14px rgba(0,0,0,.85),inset 0 2px 0 rgba(255,255,255,.2)}
.detail-info{flex:1;min-width:240px}
.detail-info h1{font-size:34px;font-weight:900;letter-spacing:-1.3px;margin-bottom:8px;line-height:1.1}
.detail-info .dev{font-size:14px;color:var(--blue);font-weight:800;margin-bottom:14px}
.detail-info .desc{font-size:14px;line-height:1.7;color:rgba(255,255,255,.75);max-width:640px}
.stat-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-bottom:26px}
@media(max-width:640px){.stat-grid{grid-template-columns:repeat(2,1fr)}}
.stat-card{background:var(--surface);border:1px solid var(--stroke);border-radius:16px;padding:16px;text-align:center;transition:all .25s}
.stat-card:hover{background:var(--surface2);transform:translateY(-2px)}
.stat-card .k{font-size:10.5px;color:var(--txt2);text-transform:uppercase;letter-spacing:1px;font-weight:800;margin-bottom:6px}
.stat-card .v{font-size:20px;font-weight:900;display:flex;align-items:center;justify-content:center;gap:4px}
.stat-card .v .s{color:var(--star);font-size:16px}
.picker{margin-bottom:26px}
.picker-label{font-size:11.5px;font-weight:900;letter-spacing:1.2px;text-transform:uppercase;color:var(--txt2);margin-bottom:14px;display:flex;align-items:center;gap:8px}
.mode-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:12px;max-width:560px}
.mode-btn{background:var(--surface);border:1.5px solid var(--stroke);border-radius:16px;padding:16px;color:var(--txt);display:flex;align-items:center;gap:14px;transition:all .22s;text-align:left}
.mode-btn:hover{background:var(--surface2)}
.mode-btn.on{background:linear-gradient(135deg,rgba(79,142,255,.22),rgba(167,139,250,.18));border-color:var(--blue);box-shadow:0 12px 28px -10px rgba(79,142,255,.6)}
.mode-btn .mi{width:44px;height:44px;border-radius:12px;background:rgba(255,255,255,.07);display:grid;place-items:center;font-size:22px}
.mode-btn .mt{font-size:14px;font-weight:900}
.mode-btn .md{font-size:11.5px;color:var(--txt2);margin-top:3px;font-weight:600}
.diff-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;max-width:560px}
.diff-btn{background:var(--surface);border:1.5px solid var(--stroke);border-radius:14px;padding:16px 12px;color:var(--txt);text-align:center;transition:all .22s}
.diff-btn:hover{background:var(--surface2)}
.diff-btn .dt{font-size:14px;font-weight:900;margin-bottom:4px}
.diff-btn .dd{font-size:11px;color:var(--txt2);font-weight:700}
.diff-btn.easy.on{background:linear-gradient(135deg,rgba(74,222,128,.22),rgba(52,211,153,.18));border-color:#4ade80}
.diff-btn.medium.on{background:linear-gradient(135deg,rgba(251,191,36,.22),rgba(249,115,22,.18));border-color:#fbbf24}
.diff-btn.hard.on{background:linear-gradient(135deg,rgba(239,68,68,.22),rgba(236,72,153,.18));border-color:#ef4444}
.play-btn{width:100%;max-width:560px;font-size:17px;font-weight:900;padding:19px 28px;border-radius:16px;border:none;background:linear-gradient(135deg,#4f8eff,#2563eb 60%,#7c3aed);color:#fff;display:flex;align-items:center;justify-content:center;gap:12px;box-shadow:0 18px 40px -12px rgba(79,142,255,.75);transition:all .22s;margin-bottom:32px}
.play-btn:hover{transform:translateY(-2px);filter:brightness(1.08)}

/* ============ DEVELOPER CREDIT ============ */
.dev-credit{position:relative;max-width:1280px;margin:40px auto 30px;padding:0 22px}
.dev-credit-in{position:relative;background:linear-gradient(135deg, rgba(79,142,255,.08), rgba(167,139,250,.08), rgba(244,114,182,.08));border:1px solid rgba(255,255,255,.1);border-radius:24px;padding:28px 24px;text-align:center;overflow:hidden;transition:all .4s cubic-bezier(.2,.9,.3,1);animation:fadeUp .8s cubic-bezier(.2,.9,.3,1)}
.dev-credit-in::before{content:'';position:absolute;inset:-2px;border-radius:inherit;background:linear-gradient(135deg,#4f8eff,#a78bfa 40%,#f472b6 70%,#4f8eff);background-size:300% 300%;opacity:.35;filter:blur(12px);z-index:-1;animation:borderFlow 8s ease-in-out infinite}
@keyframes borderFlow{0%,100%{background-position:0% 50%}50%{background-position:100% 50%}}
.dev-credit-in:hover{transform:translateY(-3px);border-color:rgba(79,142,255,.4);box-shadow:0 30px 60px -20px rgba(79,142,255,.4)}
.dev-credit-in .star-bg{position:absolute;inset:0;overflow:hidden;pointer-events:none;border-radius:inherit}
.dev-credit-in .star-bg span{position:absolute;color:rgba(255,255,255,.15);font-size:14px;animation:starFloat 8s linear infinite}
.dev-credit-in .star-bg span:nth-child(1){left:8%;top:20%;animation-delay:0s;font-size:11px}
.dev-credit-in .star-bg span:nth-child(2){left:22%;top:70%;animation-delay:1.5s;font-size:16px}
.dev-credit-in .star-bg span:nth-child(3){left:45%;top:15%;animation-delay:3s;font-size:12px}
.dev-credit-in .star-bg span:nth-child(4){left:68%;top:75%;animation-delay:4.5s;font-size:14px}
.dev-credit-in .star-bg span:nth-child(5){left:85%;top:30%;animation-delay:2s;font-size:10px}
.dev-credit-in .star-bg span:nth-child(6){left:55%;top:85%;animation-delay:5.5s;font-size:13px}
@keyframes starFloat{0%,100%{transform:translateY(0) scale(1);opacity:.15}50%{transform:translateY(-12px) scale(1.3);opacity:.4}}
.dev-credit-in .crown{font-size:36px;display:inline-block;margin-bottom:12px;filter:drop-shadow(0 4px 12px rgba(79,142,255,.6));animation:crownBounce 2.5s ease-in-out infinite}
@keyframes crownBounce{0%,100%{transform:translateY(0) rotate(-3deg)}50%{transform:translateY(-6px) rotate(3deg)}}
.dev-credit-in .label{font-size:10.5px;font-weight:900;letter-spacing:3px;text-transform:uppercase;color:rgba(255,255,255,.5);margin-bottom:12px;display:flex;align-items:center;justify-content:center;gap:10px}
.dev-credit-in .label::before,.dev-credit-in .label::after{content:'';width:30px;height:1px;background:linear-gradient(90deg,transparent,rgba(255,255,255,.4))}
.dev-credit-in .label::after{background:linear-gradient(90deg,rgba(255,255,255,.4),transparent)}
.dev-credit-in .name{font-size:26px;font-weight:900;letter-spacing:-.8px;background:linear-gradient(92deg,#4f8eff,#a78bfa 40%,#f472b6 70%,#4f8eff);background-size:200% auto;-webkit-background-clip:text;background-clip:text;color:transparent;margin-bottom:10px;animation:nameGlow 4s linear infinite}
@keyframes nameGlow{to{background-position:200% center}}
.dev-credit-in .school{font-size:14px;font-weight:800;color:#a5d8ff;letter-spacing:.3px;margin-bottom:6px;display:flex;align-items:center;justify-content:center;gap:8px;flex-wrap:wrap}
.dev-credit-in .school .dot-sep{width:4px;height:4px;border-radius:50%;background:rgba(255,255,255,.4)}
.dev-credit-in .class-badge{display:inline-flex;align-items:center;gap:6px;font-size:11.5px;font-weight:900;letter-spacing:1px;text-transform:uppercase;padding:6px 14px;border-radius:999px;background:linear-gradient(135deg,rgba(79,142,255,.2),rgba(167,139,250,.2));border:1px solid rgba(79,142,255,.35);color:#8ec2ff;margin-top:6px}
.dev-credit-in .class-badge .dot-live{width:6px;height:6px;border-radius:50%;background:#22c55e;box-shadow:0 0 8px #22c55e;animation:pulse 1.8s infinite}
@media(max-width:520px){
  .dev-credit{padding:0 16px;margin:32px auto 16px}
  .dev-credit-in{padding:22px 16px;border-radius:20px}
  .dev-credit-in .name{font-size:20px;letter-spacing:-.4px}
  .dev-credit-in .school{font-size:12px}
  .dev-credit-in .crown{font-size:30px}
  .dev-cre
